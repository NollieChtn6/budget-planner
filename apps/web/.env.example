# Base de données (voir docs/adr/0009-postgresql-and-prisma.md)
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/budget_planner"

# Base de test, utilisée par les tests qui touchent une vraie base.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5434/budget_planner_test"

# Better Auth (voir docs/adr/0008-single-user-authentication.md)
BETTER_AUTH_SECRET="generate-a-random-secret"
# BETTER_AUTH_URL : à définir en production (domaine fixe). À laisser non
# défini en local : Better Auth déduit alors l'origine de confiance de chaque
# requête (Host), ce qui évite un rejet "Invalid origin" si Next choisit un
# port différent de 3000 (par ex. parce qu'un autre projet l'occupe déjà).
# BETTER_AUTH_URL="https://exemple.com"

# Jeton de provisioning pour /setup, utile uniquement sur un hébergement
# sans accès shell (sinon utiliser `pnpm create-user`). Généré par vous,
# avec une entropie suffisante, ex. `openssl rand -hex 32` ; sans impact une
# fois le compte créé, la route se désactivant alors définitivement.
# SETUP_TOKEN="generate-a-random-token"
