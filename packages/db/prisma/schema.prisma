generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Modèles ajoutés au fil des fonctionnalités, un par entité de
// docs/domain/model.md (voir docs/adr/0009-postgresql-and-prisma.md).

// Modèles d'authentification (Better Auth), voir docs/adr/0008-single-user-authentication.md.
// Noms de modèles et de champs alignés sur les clés internes de Better Auth
// (apps/web/lib/auth.ts) : ne pas renommer sans mettre à jour la config Better Auth.

model User {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  email            String   @unique
  emailVerified    Boolean  @default(false) @map("email_verified")
  image            String?
  twoFactorEnabled Boolean? @default(false) @map("two_factor_enabled")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  sessions          Session[]
  accounts          Account[]
  twoFactors        TwoFactor[]
  variableEnvelopes VariableEnvelope[]
  fixedEntries      FixedEntry[]

  @@map("users")
}

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

// Ajouté par le plugin two-factor de Better Auth.
model TwoFactor {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  secret                  String
  backupCodes             String    @map("backup_codes")
  userId                  String    @map("user_id") @db.Uuid
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@index([userId])
  @@map("two_factors")
}

// Paramétrage des enveloppes variables (docs/domain/model.md), voir
// docs/adr/0011-user-scoped-repositories.md pour la convention userId.

enum VariableEnvelopeVersionMode {
  amount
  percentage

  @@map("variable_envelope_version_mode")
}

model VariableEnvelope {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  label        String
  archivedFrom DateTime? @map("archived_from") @db.Date

  user     User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions VariableEnvelopeVersion[]

  @@index([userId])
  @@map("variable_envelopes")
}

model VariableEnvelopeVersion {
  envelopeId    String                      @map("envelope_id") @db.Uuid
  effectiveFrom DateTime                    @map("effective_from") @db.Date
  mode          VariableEnvelopeVersionMode
  amountCents   Int?                        @map("amount_cents")
  percentage    Int?

  envelope VariableEnvelope @relation(fields: [envelopeId], references: [id], onDelete: Cascade)

  @@id([envelopeId, effectiveFrom])
  @@map("variable_envelope_versions")
}

// Paramétrage des postes fixes (docs/domain/model.md).

enum FixedEntryType {
  charge
  scheduledSaving

  @@map("fixed_entry_type")
}

model FixedEntry {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String         @map("user_id") @db.Uuid
  label        String
  type         FixedEntryType
  archivedFrom DateTime?      @map("archived_from") @db.Date

  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions FixedEntryVersion[]

  @@index([userId])
  @@map("fixed_entries")
}

model FixedEntryVersion {
  fixedEntryId  String   @map("fixed_entry_id") @db.Uuid
  effectiveFrom DateTime @map("effective_from") @db.Date
  amountCents   Int      @map("amount_cents")

  fixedEntry FixedEntry @relation(fields: [fixedEntryId], references: [id], onDelete: Cascade)

  @@id([fixedEntryId, effectiveFrom])
  @@map("fixed_entry_versions")
}
